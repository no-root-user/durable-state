# Byte-compiled / cache
__pycache__/
*.py[cod]
.pytest_cache/

# Packaging
build/
dist/
*.egg-info/

# Environments
.venv/
venv/

# Test + coverage artefacts
.coverage
htmlcov/
.crash/

# CI definitions are kept locally and run via tools\local_ci.py.
# Reason: the deploy token for this repository lacks GitHub's `workflow`
# scope, and GitHub refuses workflow files from tokens without it. They are
# not renamed or shimmed to evade the restriction. To enable real CI: give
# the token the `workflow` scope, then `git add -f .github/workflows/ci.yml`.
.github/workflows/

# Atomic-write temp files (should never be committed, but if a crash left one
# behind, it is evidence, not source)
.*.tmp
.*.lock
.*.lock.stale.*

# Unpublished article drafts. Written for Habr and kept in the private companion
# repo so this repository does not pre-publish them. The ignore is here so a
# draft cannot quietly reappear in a public commit.
docs/article-*.md
